{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "my-blog",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-15",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "force-trailing-slash",
		"not_found_handling": "404-page"
	},
	"d1_databases": [
		{
			"binding": "BLOG_DB",
			"database_name": "my-blog-stats",
			// 由 `wrangler d1 create --location apac --binding BLOG_DB --update-config` 创建。
			"database_id": "20c49913-7169-4921-b288-e0d50187bf1e",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}

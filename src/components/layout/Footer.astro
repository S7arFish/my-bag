---
import Icon from "@components/common/Icon.astro";
import { footerConfig, homeConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getSortedPosts } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();

// 从配置中获取站点开始日期
const siteStartDate = siteConfig.siteStartDate || "2025-01-01";
const { socialLinks, beian, poweredBy } = footerConfig;

// 获取最新文章日期（用于计算最后活动时间）
const posts = await getSortedPosts();
const latestPost = posts.reduce((latest, post) => {
	if (!latest) return post;
	return post.data.published > latest.data.published ? post : latest;
}, posts[0]);

const lastPostDate = latestPost
	? latestPost.data.published.toISOString()
	: null;
const lastUpdateDate = siteConfig.siteLastUpdateDate || lastPostDate;
const siteTimezone = siteConfig.timezone || "Asia/Shanghai";

const runningDaysText = i18n(I18nKey.footerRunningDays);
const lastUpdateText = i18n(I18nKey.footerLastUpdate);
const todayText = i18n(I18nKey.today);

// mailto:/tel: 链接不在新标签打开
const isExternalLink = (href: string) => !/^(mailto:|tel:)/i.test(href);
---

<div
	class="transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6"
>
	<div class="transition text-50 text-base text-center wrap flex flex-col gap-2">
		{/* 第一层：社交链接 */}
		<div class="flex items-center justify-center gap-3 text-neutral-500 dark:text-neutral-400 text-sm flex-wrap">
			{socialLinks.map((link, index) => (
				<>
					<a
						class="transition text-(--primary) font-bold hover:scale-105 inline-flex items-center gap-1"
						target={isExternalLink(link.href) ? "_blank" : undefined}
						href={link.href}
					>
						<Icon name={link.icon} is:inline class="text-base" />
						<span>{link.label}</span>
					</a>
					{index < socialLinks.length - 1 && (
						<span class="text-neutral-300 dark:text-neutral-600">|</span>
					)}
				</>
			))}
		</div>

		{/* 第二层：RSS | 隐私政策 | 用户协议 */}
		<div class="flex items-center justify-center gap-2 text-neutral-500 dark:text-neutral-400 text-sm">
			<a
				class="transition text-(--primary) font-bold hover:scale-105 inline-flex items-center gap-1"
				target="_blank"
				href={url("rss/")}
			>
				<Icon name="material-symbols:rss-feed-rounded" is:inline class="text-base" />
				<span>RSS</span>
			</a>
			<span class="text-neutral-300 dark:text-neutral-600">|</span>
			<button
				class="transition text-(--primary) font-bold bg-transparent border-none cursor-pointer p-0 hover:scale-105 inline-flex items-center gap-1"
				onclick="window.openPrivacyModal && window.openPrivacyModal()"
				type="button"
			>
				<Icon name="material-symbols:shield-outline" is:inline class="text-base" />
				<span>隐私政策</span>
			</button>
			<span class="text-neutral-300 dark:text-neutral-600">|</span>
			<button
				class="transition text-(--primary) font-bold bg-transparent border-none cursor-pointer p-0 hover:scale-105 inline-flex items-center gap-1"
				onclick="window.openUserAgreementModal && window.openUserAgreementModal()"
				type="button"
			>
				<Icon name="material-symbols:description-outline" is:inline class="text-base" />
				<span>用户协议</span>
			</button>
		</div>

		{/* 第三层：站点运行信息 */}
		<div class="flex items-center justify-center gap-3 text-neutral-500 dark:text-neutral-400 text-sm">
			<span class="flex items-center gap-1">
				<Icon name="material-symbols:calendar-clock-outline" is:inline class="text-base" />
				<span
					id="footer-running-days"
					data-template={runningDaysText}
					data-start-date={siteStartDate}
					data-timezone={siteTimezone}
				>--</span>
			</span>
			<span class="text-neutral-300 dark:text-neutral-600">|</span>
			<span class="flex items-center gap-1">
				<Icon name="mingcute:heartbeat-line" is:inline class="text-base" />
				<span
					id="footer-last-update"
					data-template={lastUpdateText}
					data-today={todayText}
					data-last-update-date={lastUpdateDate}
					data-timezone={siteTimezone}
				>--</span>
			</span>
		</div>

		{/* 第四层：版权 */}
		<div class="flex items-center justify-center gap-2 text-neutral-500 dark:text-neutral-400 text-sm flex-wrap">
			<span>&copy; <span id="copyright-year">{currentYear}</span> {homeConfig.name}</span>
		</div>

		{/* 第五层：备案信息 */}
		{(beian.icp || beian.police) && (
			<div class="flex items-center justify-center gap-2 text-neutral-500 dark:text-neutral-400 text-sm flex-wrap">
				{beian.icp && (
					<a
						class="transition text-(--primary) font-bold hover:scale-105 inline-flex items-center gap-1"
						target="_blank"
						href={beian.icpUrl}
					>
						<span>{beian.icp}</span>
					</a>
				)}
				{beian.icp && beian.police && (
					<span class="text-neutral-300 dark:text-neutral-600">|</span>
				)}
				{beian.police && (
					<a
						class="transition text-(--primary) font-bold hover:scale-105 inline-flex items-center gap-1"
						target="_blank"
						rel="noreferrer"
						href={beian.policeUrl}
					>
						<img src={beian.policeIcon} alt="公安网备" class="w-4 h-4 inline-block" />
						<span>{beian.police}</span>
					</a>
				)}
			</div>
		)}

		{/* 第六层：Powered by */}
		<div class="flex items-center justify-center gap-1 text-neutral-500 dark:text-neutral-400 text-sm">
			{poweredBy.map((item, index) => (
				<>
					<span>{item.label}</span>
					<a
						class="transition text-(--primary) font-bold hover:scale-105"
						target="_blank"
						href={item.href}
					>
						{item.name}
					</a>
					{index < poweredBy.length - 1 && (
						<span class="text-neutral-300 dark:text-neutral-600">|</span>
					)}
				</>
			))}
		</div>
	</div>
</div>

<script>
	import {
		calculateDaysSinceUpdate,
		calculateRunningDays,
	} from "@/utils/footer-stats";

	function updateFooterStats() {
		const today = new Date();
		const runningDaysEl = document.getElementById('footer-running-days');
		if (runningDaysEl) {
			const startDate = runningDaysEl.dataset.startDate;
			const timezone = runningDaysEl.dataset.timezone || "Asia/Shanghai";
			const diffDays = startDate
				? calculateRunningDays(startDate, today, timezone)
				: 1;
			const template = runningDaysEl.dataset.template || '已运行 {days} 天';
			runningDaysEl.textContent = template.replace('{days}', diffDays.toString());
		}

		const lastUpdateEl = document.getElementById('footer-last-update');
		const lastUpdateDate = lastUpdateEl?.dataset.lastUpdateDate;
		if (lastUpdateEl && lastUpdateDate) {
			const timezone = lastUpdateEl.dataset.timezone || "Asia/Shanghai";
			const daysSinceLastUpdate = calculateDaysSinceUpdate(
				lastUpdateDate,
				today,
				timezone,
			);
			const template = lastUpdateEl.dataset.template || '最后更新于 {days} 天前';
			const todayText = lastUpdateEl.dataset.today || '今天';

			if (daysSinceLastUpdate === 0) {
				lastUpdateEl.textContent = todayText;
			} else {
				lastUpdateEl.textContent = template.replace('{days}', daysSinceLastUpdate.toString());
			}
		}
	}

	updateFooterStats();

	if (!window.__footer_listener) {
		window.__footer_listener = true;
		document.addEventListener("astro:page-load", () => {
			setTimeout(updateFooterStats, 100);
		});
	}
</script>
